{
  "name": "carousel-studio",
  "version": "2.1.6",
  "scripts": {
    "dev": "concurrently \"bun run server\" \"bun run client\"",
    "server": "bun --watch server.ts",
    "client": "cd client && bun run dev",
    "build": "cd client && bun run build",
    "start": "bun server.ts",
    "typecheck": "tsc --noEmit && cd client && tsc --noEmit",
    "test": "bun test tests/",
    "test:golden:update": "python3 tests/golden.py update"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "concurrently": "^9.0.0",
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^5.7.3"
  },
  "description": "Design, generate and export Instagram/TikTok carousels. Bring your own API keys.",
  "license": "MIT"
}
