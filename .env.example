# Copy this file to `.env` and fill in your keys.
#   cp .env.example .env
#
# Real environment variables take precedence over this file. If you use Claude
# Code, keys already in ~/.claude/.env are picked up automatically and you can
# leave this file out entirely.

# Writes the slide copy and captions. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional fallback used only when ANTHROPIC_API_KEY is unset (model: gpt-5-mini)
OPENAI_API_KEY=

# Generates background images. Get one at https://kie.ai
KIE_API_KEY=

# Optional. Where exported carousels are written.
# Defaults to ./exports inside the project.
# CAROUSEL_EXPORT_DIR=~/Desktop/carousels

# Optional. Extra hostnames allowed to reach the Vite dev server, comma
# separated. Needed if you tunnel the app to a phone or tablet via ngrok.
# VITE_ALLOWED_HOSTS=your-domain.ngrok-free.app
